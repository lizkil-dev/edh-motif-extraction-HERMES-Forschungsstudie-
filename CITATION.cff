    url: "https://iconclass.org/"
  - type: database
    title: "EAGLE Vocabulary - Decoration"
    url: "https://www.eagle-network.eu/voc/decor.html"
  - type: database
    title: "Epigraphic Database Bari (EDB)"
    url: "https://www.edb.uniba.it/"
